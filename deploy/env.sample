# /etc/curio/env — what curio.service reads (EnvironmentFile=).
#
# Copy, fill in, and keep on the box. Nothing here is a secret; curio holds none. Every value has a
# working default for LOCAL dev, which is exactly what makes this file dangerous to forget: a missing
# line does not fail, it quietly points production at the wrong place.

# THE DANGEROUS ONE, AND IT IS DANGEROUS IN THE OPPOSITE DIRECTION TO EVERYTHING ELSE HERE.
#
# curio binds 127.0.0.1 by default, on purpose: four of its routes CHANGE THE STORE and not one of
# them asks who is calling. On a workstation that is exactly right. Here it cannot stay, because the
# visitor's BROWSER fetches every venue image straight from curio — boardwalk injects this host into
# the page as window.VENUES.assetBase — so curio has to be reachable from the public internet.
#
# Which means the proxy in front of it is not a nicety, it is the entire security model:
#
#     location /a/     { proxy_pass http://127.0.0.1:19463; }
#     location /health { proxy_pass http://127.0.0.1:19463; }
#     # everything else is NOT published: / is the console, /api/* mutates the store with no
#     # authentication, /intake/* serves files nobody has decided to keep yet.
#
# CONFIRM THAT VHOST EXISTS AND FORWARDS ONLY THOSE TWO BEFORE SETTING THIS LINE. With 0.0.0.0 and
# no proxy, anyone who can reach port 19463 can unpublish a name or empty intake/ with one request.
CURIO_BIND=0.0.0.0
CURIO_PORT=19463

# WHERE THE MASTERS ARE. systemd's StateDirectory=curio creates this, owned by the service user.
#
# Set it explicitly. The default is ./data relative to the WORKING DIRECTORY, so a service started
# from anywhere else finds an empty store — and an empty store does not error, it answers 404 for
# every asset while /health cheerfully reports ok:true. The first two lines of the journal say what
# curio resolved and how many assets it found; read them after deploying.
CURIO_DATA=/var/lib/curio

# RENDITIONS. Regenerable, hence /var/cache, hence CacheDirectory=curio in the unit. Safe to delete
# at any time; the next request rebuilds only what it needs.
CURIO_CACHE=/var/cache/curio

# NO BACKUP ON THIS BOX.
#
# curio's backup keeps a read-only copy of every master plus every version it has replaced, which is
# what makes an accidental overwrite recoverable. That belongs where the art is AUTHORED. Here the
# masters arrived by rsync from a machine that already holds all of it, so a second copy would be
# weight without insurance. Recovery here is another rsync.
CURIO_BACKUP=none

# Concurrent renders. Every permit is a decode plus a scale held in memory, so this is a memory
# ceiling as much as a CPU one. Default is half the cores, capped at 4.
# CURIO_RENDER_JOBS=2

# How large cache/ may grow before the oldest renditions are evicted. Default 2048.
# CURIO_CACHE_MAX_MB=1024

# Only if the binary and public/ are not deployed side by side. public/ holds console.html, which is
# not published through the proxy anyway — so on a headless box this can be left wrong without
# anything noticing.
# CURIO_PUBLIC=/opt/curio/public
